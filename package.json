{
  "name": "preencemeka-university-microservices",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "start:frontend": "npm run dev --workspace frontend -- --host 0.0.0.0",
    "start:gateway": "npm run start --workspace api-gateway",
    "start:auth": "npm run start --workspace auth-service",
    "start:student": "npm run start --workspace student-service",
    "start:course": "npm run start --workspace course-service",
    "start:grades": "npm run start --workspace grades-service"
  }
}
